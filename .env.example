# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# For local development with Docker Compose: postgres://postgres:postgres@localhost:5432/eslee
# For production (Neon/Supabase): postgres://...
DATABASE_URL="postgres://postgres:postgres@localhost:5432/eslee"

# Used by Vercel to authenticate scheduled queue collection requests.
CRON_SECRET="replace-with-a-long-random-secret"

# Required to collect opening hours for every store through Google Places.
GOOGLE_MAPS_API_KEY=""

# Populated by the Upstash for Redis Vercel Marketplace integration.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ---------------------------------------------------------------------------
# NextAuth (Legacy - used by @eslee/next-auth)
# ---------------------------------------------------------------------------
AUTH_SECRET='supersecret'
AUTH_DISCORD_ID=''
AUTH_DISCORD_SECRET=''
# AUTH_REDIRECT_PROXY_URL='https://auth.your-server.com/r'

# ---------------------------------------------------------------------------
# Better Auth (used by @eslee/auth)
# ---------------------------------------------------------------------------
# You can generate the secret via 'openssl rand -base64 32' on Unix
BETTER_AUTH_SECRET='your-secret-at-least-32-characters-long'
BETTER_AUTH_URL='http://localhost:3003'
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''

# ---------------------------------------------------------------------------
# Payload CMS
# ---------------------------------------------------------------------------
PAYLOAD_SECRET="super-secret-payload-key-change-me"

# ---------------------------------------------------------------------------
# Cloudflare R2 (Payload media storage)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="eslee-io-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
AI_GATEWAY_API_KEY=''
OPENAI_API_KEY=''
ANTHROPIC_API_KEY=''
