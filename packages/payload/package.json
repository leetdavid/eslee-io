{
  "name": "@eslee/payload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "migrate:vercel-blob-to-r2": "dotenv -e ../../.env -- tsx scripts/migrate-vercel-blob-to-r2.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "catalog:payload",
    "@payloadcms/next": "catalog:payload",
    "@payloadcms/richtext-lexical": "catalog:payload",
    "@payloadcms/storage-s3": "catalog:payload",
    "@payloadcms/ui": "catalog:payload",
    "ai": "^6.0.116",
    "exifr": "^7.1.3",
    "next": "catalog:",
    "payload": "catalog:payload",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@eslee/tsconfig": "workspace:*",
    "@aws-sdk/client-s3": "^3.614.0",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vercel/blob": "2.6.1",
    "dotenv-cli": "catalog:",
    "graphql": "^16.8.1",
    "postgres": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:"
  }
}
