{
  "name": "@eslee/jev-mbti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "pnpm with-env next dev --turbopack -p 3011",
    "start": "pnpm with-env next start -p 3011",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:responsive": "tsx scripts/check-responsive.ts",
    "evaluate:model": "NODE_OPTIONS=--conditions=react-server pnpm with-env tsx scripts/evaluate-model.ts",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:migrate": "pnpm with-env tsx scripts/migrate.ts",
    "examples": "NODE_OPTIONS=--conditions=react-server pnpm with-env tsx scripts/examples.ts",
    "with-env": "dotenv -e .env.local -e ../../.env.local -e ../../.env --"
  },
  "dependencies": {
    "@eslee/db": "workspace:*",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "catalog:",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.53.0",
    "next": "15.5.27",
    "pdfjs-dist": "^6.4.299",
    "postgres": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "server-only": "0.0.1",
    "unicode-case-folding": "^1.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslee/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "^4.0.0"
  }
}
