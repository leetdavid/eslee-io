# Railway PostgreSQL in production; locally, an embedded database in .pglite.
DATE_A_GLOBE_DATABASE_URL=pglite:.pglite
# Any long random string; it keys the per-address daily limits.
RATE_LIMIT_SECRET=
# Where better-auth lives for this app.
BETTER_AUTH_URL=http://localhost:3012
# Sign-in also needs, from the monorepo root: BETTER_AUTH_SECRET and DATABASE_URL in .env,
# and GITHUB_CLIENT_ID_DEV / GITHUB_CLIENT_SECRET_DEV (or _PROD) in .env.github.
