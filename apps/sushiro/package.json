{
  "name": "@eslee/sushiro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "pnpm with-env next dev -p 3005 --turbopack",
    "start": "pnpm with-env next start -p 3005",
    "test": "vitest run",
    "estimates:backtest": "pnpm with-env tsx scripts/backtest-estimates.ts",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:migrate": "pnpm with-env tsx scripts/migrate.ts",
    "db:backfill": "pnpm with-env tsx scripts/backfill-neon.ts",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@eslee/db": "workspace:*",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@eslee/tsconfig": "workspace:*",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "^5.0.0"
  }
}
